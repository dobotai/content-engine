# Airtable
# You paste the token: airtable.com/create/tokens, scopes data.records:read,
# data.records:write, schema.bases:read, schema.bases:write, access to all bases.
AIRTABLE_TOKEN=
# execution/setup_airtable.py fills in the three ids below when it builds the base.
AIRTABLE_BASE_ID=
ALL_CONTENT_TABLE_ID=
IG_POSTS_TABLE_ID=

# Instagram (Setup Prompt 2 in README.md fills this)
# The IGAA... token from your Meta app's "API setup with Instagram login"
INSTAGRAM_ACCESS_TOKEN=
